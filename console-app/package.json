{
  "name": "verifica-placa-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-config.mjs && node scripts/build-overview.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-config.mjs && node scripts/build-overview.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/domain/*.test.ts && node --test scripts/overview-parity.test.mjs",
    "release": "npm run build && node scripts/release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "chart.js": "4.4.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
