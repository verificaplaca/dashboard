{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix console-app",
  "buildCommand": "npm run build:vercel --prefix console-app",
  "outputDirectory": "console-app/dist",
  "redirects": [
    { "source": "/console", "destination": "/", "permanent": false },
    { "source": "/console/", "destination": "/", "permanent": false },
    { "source": "/dashboard/console", "destination": "/", "permanent": false },
    { "source": "/dashboard/console/", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
